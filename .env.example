# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Бот: @BotFather → /newbot. Chat id: добавьте бота в чат, напишите сообщение
# и откройте https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно
DB_PATH=data/reviews.db
BATCH_SIZE=15
